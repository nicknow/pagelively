# Inputs for the human-run provisioning script (`npm run setup` → setup.mjs, built in a
# later phase). Copy to `.env` and fill in real values ONLY at deploy time.
# NEVER commit a real .env.
#
# Required API token scopes are listed in docs/operations/ (provisioning guide).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
ADMIN_EMAILS=you@example.com
