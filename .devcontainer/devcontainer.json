{
  "name": "pagelively",
  // Node 24 (Active LTS) devcontainer image. Wrangler officially supports
  // Current/Active/Maintenance Node releases — see
  // https://developers.cloudflare.com/workers/wrangler/install-and-update/
  // Pin is exact for reproducibility; bump deliberately.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.0.3-24-bookworm",
  "forwardPorts": [8787],
  // Install dependencies and prepare the local D1 database (runs migrations
  // into the local emulation) so `npm test` works on first boot. No cloud
  // credentials are involved anywhere in the image or commands.
  "postCreateCommand": "npm install && npm run db:local:migrate",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
